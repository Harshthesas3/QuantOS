{
  "name": "quantos",
  "version": "0.1.0",
  "description": "An educational operating system for learning OS concepts",
  "main": "src-tauri/src/main.rs",
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "vite",
    "build": "tauri build",
    "build:frontend": "vite build",
    "preview": "tauri preview",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "verify": "npm run type-check && npm run lint && npm run test && npm run build:frontend",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "operating system",
    "education",
    "learning",
    "tutorial",
    "simulation"
  ],
